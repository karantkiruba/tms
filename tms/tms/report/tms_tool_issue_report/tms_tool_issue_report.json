 "query": "SELECT\r\n    ti.posting_date AS \"Date:Date:150\",\r\n    tii.item_code AS \"Tool Code:Link/Item:180\",\r\n    tii.item_name as \"Tool Name:Data:180\",\r\n    tii.qty AS \"Qty:Float:100\",\r\n    tii.issue_value AS \"Tool Value:Currency:120\"\r\nFROM\r\n    `tabTMS Tool Issue` ti\r\nINNER JOIN\r\n    `tabTMS Tool Issue Item` tii\r\n    ON tii.parent = ti.name\r\nWHERE\r\n    ti.docstatus = 1 and ti.posting_date between %(from_date)s and %(to_date)s\r\nORDER BY\r\n    ti.posting_date DESC",
